BOT_TOKEN=

# Remote storage (recommended for Raspberry Pi SD-card protection).
# Create the tables described in README.md, then copy these values from Supabase.
SUPABASE_URL=
SUPABASE_KEY=

# Optional override for the delete-all password. Default: New_Creation
MASTER_DELETE_PASSWORD=New_Creation

# Optional health-check port (default: 8080).
PORT=8080

# Optional logging verbosity: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
