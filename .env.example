BOT_TOKEN=
TMDB_API_KEY=

# Optional remote persistence. If omitted, the bot uses bot.db locally.
SUPABASE_URL=
SUPABASE_KEY=

# Optional AI assistant.
MISTRAL_API_KEY=

# Optional health-check port (default: 8080).
PORT=8080

# Optional ordered DDGS backends. Defaults avoid DuckDuckGo's auto fan-out.
# Example: yahoo,wikipedia,grokipedia,duckduckgo
DDG_BACKENDS=yahoo,wikipedia,grokipedia
